; Engine configuration file.
; 캐슬 제패(가칭) — Godot 4.7 · Compatibility 렌더러(폰 · CI 에뮬레이터 · 가상 화면 공통) · 세로 1080x1920 (CLAUDE.md 0절 핵심 상수)

config_version=5

[application]

config/name="캐슬 제패"
config/description="캐슬 제패(가칭) — 조직 경영 전략 · 비공개 · 비영리 팬게임"
run/main_scene="res://main.tscn"
config/features=PackedStringArray("4.7", "GL Compatibility")
config/icon="res://assets/icon.svg"
config/quit_on_go_back=false

[audio]

driver/enable_input=false

[display]

window/size/viewport_width=1080
window/size/viewport_height=1920
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"
window/handheld/orientation=1

[gui]

theme/custom="res://ui/theme.tres"

[rendering]

renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
textures/vram_compression/import_etc2_astc=true
environment/defaults/default_clear_color=Color(0.055, 0.06, 0.085, 1)
